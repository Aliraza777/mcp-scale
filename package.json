{
  "name": "mcp-scale",
  "version": "0.1.1-beta.0",
  "description": "Weigh your MCP setup: see how many context-window tokens every MCP server costs you, across Claude Code, Cursor, VS Code, Windsurf, Codex and more.",
  "homepage": "https://github.com/Aliraza777/mcp-scale#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aliraza777/mcp-scale.git"
  },
  "bugs": {
    "url": "https://github.com/Aliraza777/mcp-scale/issues"
  },
  "type": "module",
  "bin": {
    "mcp-scale": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "cursor",
    "tokens",
    "context-window",
    "cli",
    "ai-agents"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "commander": "15.0.0",
    "js-tiktoken": "1.0.21",
    "picocolors": "1.1.1",
    "smol-toml": "1.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "25.9.9",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "author": "aliwahlah <aliwahlah777@gmail.com>"
}
